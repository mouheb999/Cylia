# Coordonnées publiques du projet Supabase.
#
# Ces deux valeurs partent dans le navigateur : elles n'ont rien de secret,
# c'est RLS qui protège les données. Elles sont donc versionnées ici.
#
# Pour développer :  cp .env.example .env.local
# Sur Vercel : les déclarer dans Settings → Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://sybrraiyllmhlkwbfcod.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable__xiDtEYOW-2sFV0ckC0M3g_c0zTHYea

# ----------------------------------------------------------- notifications
#
# Alertes du salon : une bulle sur le téléphone à chaque nouvelle demande de
# rendez-vous, panneau fermé. Sans ces trois valeurs, le site fonctionne
# exactement comme avant — simplement, rien ne notifie.
#
# 1. Générer la paire de clés (une fois, sur votre machine) :
#       npx web-push generate-vapid-keys
# 2. Déclarer les trois valeurs sur Vercel, Settings → Environment Variables.
#
# La clé publique part dans le navigateur, c'est son rôle. La clé privée
# **reste sur le serveur** : elle seule prouve que l'envoi vient de ce site.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUJET=mailto:contact@cylia.tn

# Clé secrète du projet Supabase (Settings → API Keys → `sb_secret_…`).
#
# Elle ne sert qu'à l'envoi des notifications : au moment où une cliente
# réserve, il n'y a aucune session administratrice à porter, et la liste des
# appareils du salon n'est lisible que par une administratrice.
#
# Ne jamais la préfixer NEXT_PUBLIC_, ne jamais la committer.
SUPABASE_SECRET_KEY=
