# Coordonnées publiques du projet Supabase.
#
# Ces deux valeurs partent dans le navigateur : elles n'ont rien de secret,
# c'est RLS qui protège les données. Elles sont donc versionnées ici.
#
# Pour développer :  cp .env.example .env.local
# Sur Vercel : les déclarer dans Settings → Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://sybrraiyllmhlkwbfcod.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable__xiDtEYOW-2sFV0ckC0M3g_c0zTHYea

# ----------------------------------------------------------- notifications
#
# Alertes du salon : une bulle sur le téléphone à chaque nouvelle demande de
# rendez-vous, panneau fermé. Sans ces trois valeurs, le site fonctionne
# exactement comme avant — simplement, rien ne notifie.
#
# 1. Générer la paire de clés (une fois, sur votre machine) :
#       npx web-push generate-vapid-keys
# 2. Déclarer les trois valeurs sur Vercel, Settings → Environment Variables.
#
# La clé publique part dans le navigateur, c'est son rôle. La clé privée
# **reste sur le serveur** : elle seule prouve que l'envoi vient de ce site.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUJET=mailto:contact@cylia.tn

# Clé secrète du projet Supabase (Settings → API Keys → `sb_secret_…`).
#
# Elle ne sert qu'à l'envoi des notifications : au moment où une cliente
# réserve, il n'y a aucune session administratrice à porter, et la liste des
# appareils du salon n'est lisible que par une administratrice.
#
# Ne jamais la préfixer NEXT_PUBLIC_, ne jamais la committer.
SUPABASE_SECRET_KEY=

# ------------------------------------------------------------------ publicité
#
# Pixel Meta du salon (Events Manager → « cylia »). Il mesure les vues, les
# prises de contact, les demandes de rendez-vous et le parcours d'achat de la
# boutique (ViewContent, AddToCart, InitiateCheckout, Purchase), pour que les
# publicités d'Ads Manager puissent être optimisées dessus.
#
# Sans cette variable, c'est l'identifiant du salon qui sert (voir
# `lib/meta/track.ts`). La déclarer quand même sur Vercel : l'API Conversions
# l'utilise aussi, et un pixel de test se vise en la changeant.
NEXT_PUBLIC_META_PIXEL_ID=4465663150349853

# Jeton de l'API Conversions — le même évènement envoyé par le serveur, que
# les bloqueurs de publicité et Safari ne peuvent pas intercepter.
#
# Events Manager → pixel « cylia » → Paramètres → API Conversions → « Générer
# un jeton d'accès ». Secret : jamais préfixé NEXT_PUBLIC_, jamais committé.
# Sans lui, seul le pixel du navigateur mesure ; le site marche pareil.
META_CAPI_TOKEN=

# Facultatif. Code « Tester les évènements » d'Events Manager (TEST12345) :
# tant qu'il est déclaré, les évènements serveur arrivent dans l'onglet de
# test au lieu des statistiques réelles. À retirer une fois les tests finis.
META_TEST_EVENT_CODE=

# Facultatif. Vérification du domaine par Meta : Business Manager → Sécurité
# de la marque → Domaines → « Balise méta ». Ne coller que la valeur du
# `content`, pas la balise entière.
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=

# Second pixel (facultatif) : celui du portefeuille qui diffuse les publicités.
# Reçoit les mêmes évènements que le pixel du salon, navigateur et serveur.
NEXT_PUBLIC_META_PIXEL_ID_2=
# Jeton API Conversions généré sur ce second pixel (Paramètres → Générer un token).
META_CAPI_TOKEN_2=
